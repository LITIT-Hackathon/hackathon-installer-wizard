{
  "name": "litit-smart-installer-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ./node_modules/@remotion/cli/remotion-cli.js studio src/index.ts",
    "render": "node ./node_modules/@remotion/cli/remotion-cli.js render src/index.ts SmartInstallerDemo out/smart-installer-demo.mp4 --codec=h264 --crf=17",
